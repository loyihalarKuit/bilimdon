# Ilova
PROJECT_NAME="Bilimdon API"
ENVIRONMENT=development

# PostgreSQL ulanishi
DATABASE_URL=postgresql+psycopg://bilim:bilim@localhost:5432/bilim

# JWT — productionda albatta uzun tasodifiy qiymat qo'ying:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend manzillari (vergul bilan)
CORS_ORIGINS=http://localhost:3000

# Seed skripti yaratadigan admin
FIRST_ADMIN_EMAIL=admin@bilimdon.uz
FIRST_ADMIN_PASSWORD=Admin12345
